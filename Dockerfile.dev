FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install from source (gradio==5.19.0, compatible pyannote)
COPY pyproject.toml README.md LICENSE ./
COPY gryannote/ gryannote/
RUN pip install --no-cache-dir . pydub

# Extract pre-built frontend templates from PyPI wheel into site-packages
RUN pip download gryannote==0.3.0 --no-deps -d /tmp/wheel && \
    python -c "
import zipfile, site, os
wheel = '/tmp/wheel/gryannote-0.3.0-py3-none-any.whl'
sp = site.getsitepackages()[0]
with zipfile.ZipFile(wheel) as z:
    for name in z.namelist():
        if '/templates/' in name:
            dest = os.path.join(sp, name)
            os.makedirs(os.path.dirname(dest), exist_ok=True)
            with z.open(name) as src, open(dest, 'wb') as dst:
                dst.write(src.read())
            print(f'Copied: {name}')
" && rm -rf /tmp/wheel

# Patch gradio_client bug: boolean additionalProperties crashes schema parsing
COPY patches/fix-gradio-client-bool-schema.py /tmp/
RUN python /tmp/fix-gradio-client-bool-schema.py && rm /tmp/fix-gradio-client-bool-schema.py

COPY demo/ demo/

EXPOSE 7860

CMD ["python", "demo/app.py"]
