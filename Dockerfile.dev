FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ffmpeg \
    libsndfile1 \
    && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Layer 1: PyTorch (~346s) — only rebuilds when CUDA version changes
RUN pip install --no-cache-dir torch torchaudio --index-url https://download.pytorch.org/whl/cu121

# Layer 2: Python deps (~408s) — only rebuilds when pyproject.toml changes
COPY pyproject.toml README.md LICENSE ./
RUN mkdir -p gryannote/audio/backend/gryannote_audio \
             gryannote/pipeline/backend/gryannote_pipeline \
             gryannote/rttm/backend/gryannote_rttm && \
    touch gryannote/audio/backend/gryannote_audio/__init__.py \
          gryannote/pipeline/backend/gryannote_pipeline/__init__.py \
          gryannote/rttm/backend/gryannote_rttm/__init__.py && \
    pip install --no-cache-dir -e . pydub build

# Patch gradio_client bug
COPY patches/fix-gradio-client-bool-schema.py /tmp/
RUN python /tmp/fix-gradio-client-bool-schema.py && rm /tmp/fix-gradio-client-bool-schema.py

# Layer 3: Source code — changes frequently, but layers 1-2 stay cached
COPY gryannote/ gryannote/

# Install npm deps for each component frontend
RUN cd gryannote/audio/frontend && npm install && \
    cd /app/gryannote/pipeline/frontend && npm install && \
    cd /app/gryannote/rttm/frontend && npm install

# Patch @gradio/preview to handle 'import type' syntax
COPY patches/fix-gradio-preview-type-imports.py /tmp/
RUN cd /app/gryannote/audio/frontend && python /tmp/fix-gradio-preview-type-imports.py && \
    cd /app/gryannote/pipeline/frontend && python /tmp/fix-gradio-preview-type-imports.py && \
    cd /app/gryannote/rttm/frontend && python /tmp/fix-gradio-preview-type-imports.py && \
    rm /tmp/fix-gradio-preview-type-imports.py

# Build frontend templates for gradio 5.x
RUN cd /app/gryannote/audio && gradio cc build --no-generate-docs && \
    cd /app/gryannote/pipeline && gradio cc build --no-generate-docs && \
    cd /app/gryannote/rttm && gradio cc build --no-generate-docs

COPY demo/ demo/

EXPOSE 7860

CMD ["python", "demo/app.py"]
